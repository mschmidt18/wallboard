[Unit]
Description=Wallboard Server (Node.js/Fastify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wallboard
Group=wallboard
WorkingDirectory=/opt/wallboard
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/wallboard/dist/server/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wallboard-server

[Install]
WantedBy=multi-user.target
