[Unit]
Description=Wallboard Display (Kiosk Browser)
After=wallboard-server.service network-online.target
Requires=wallboard-server.service
Wants=network-online.target

[Service]
Type=simple
User=wallboard
Group=wallboard
SupplementaryGroups=video input tty
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wallboard-display
PAMName=login
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/0
ExecStart=/opt/wallboard/bin/wallboard-display
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
