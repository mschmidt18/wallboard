[Unit]
Description=Wallboard Display (Kiosk Browser)
After=wallboard-server.service network-online.target
Requires=wallboard-server.service
Wants=network-online.target

[Service]
Type=simple
User=wallboard
Group=wallboard
SupplementaryGroups=video input render
PAMName=login
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wallboard-display
Environment=XDG_RUNTIME_DIR=/tmp/wallboard-xdg
ExecStartPre=/bin/mkdir -p /tmp/wallboard-xdg
ExecStartPre=/bin/chown wallboard:wallboard /tmp/wallboard-xdg
ExecStart=/opt/wallboard/bin/wallboard-display
Restart=on-failure
RestartSec=10
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
