#!/usr/bin/env bash
#
# wallboard-display - Launch Chromium in kiosk mode via cage (Wayland)
#
# Called by wallboard-display.service. Not intended to be run manually.
#

set -euo pipefail

WALLBOARD_URL="http://localhost:8000"

# Detect Chromium binary (chromium-browser on Raspberry Pi OS, chromium on Debian)
if command -v chromium-browser &> /dev/null; then
    CHROMIUM="chromium-browser"
elif command -v chromium &> /dev/null; then
    CHROMIUM="chromium"
else
    echo "ERROR: Chromium not found" >&2
    exit 1
fi

# Wait for the wallboard server to be reachable before launching the browser
for i in $(seq 1 30); do
    if curl -sf http://localhost:8000/api/health > /dev/null 2>&1; then
        break
    fi
    sleep 1
done

# Prevent cage from failing if no input devices are connected
export WLR_LIBINPUT_NO_DEVICES=1

# Launch Chromium kiosk inside cage (Wayland kiosk compositor)
exec cage -d -s -- $CHROMIUM \
    --kiosk \
    --no-first-run \
    --noerrdialogs \
    --disable-infobars \
    --no-sandbox \
    --ozone-platform=wayland \
    --disable-features=TranslateUI \
    $WALLBOARD_URL
