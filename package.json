{
  "name": "wallboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude src/frontend --exclude node_modules src/server/index.ts",
    "build": "tsc -p src/server/tsconfig.json && tsc-alias -p src/server/tsconfig.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p src/server/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^10.1.3",
    "@sinclair/typebox": "^0.34.33",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.1",
    "icloud-shared-album": "^1.2.1",
    "node-ical": "^0.24.2",
    "pino": "^9.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.2",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.1.18",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.4",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "icloud-shared-album": {
      "axios": "^1.20.0"
    }
  }
}
